{
  "name": "site_blocker",
  "version": "1.0.0",
  "private": true,
  "description": "Block distracting and harmful websites, including subdomains.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc && vp build",
    "clear": "rm -rf dist",
    "lint": "vp lint .",
    "format": "vp lint . --fix",
    "icon:16": "sharp -i public/icon/icon.svg -o public/icon/16.png resize 16",
    "icon:32": "sharp -i public/icon/icon.svg -o public/icon/32.png resize 32",
    "icon:48": "sharp -i public/icon/icon.svg -o public/icon/48.png resize 48",
    "icon:96": "sharp -i public/icon/icon.svg -o public/icon/96.png resize 96",
    "icon:128": "sharp -i public/icon/icon.svg -o public/icon/128.png resize 128",
    "generate-icons": "pnpm run icon:16 && pnpm run icon:32 && pnpm run icon:48 && pnpm run icon:96 && pnpm run icon:128",
    "prepare": "vp config"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.9.1",
    "@mui/icons-material": "9.5.0",
    "@mui/lab": "9.0.0-beta.10",
    "@mui/material": "9.5.0",
    "@uiw/react-json-view": "2.0.0-alpha.44",
    "notistack": "^3.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-transition-group": "^4.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@hookform/devtools": "^4.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-transition-group": "^4.4.12",
    "@types/webextension-polyfill": "^0.12.6",
    "@vitejs/plugin-react": "6.1.2",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "^17.13.0",
    "oxc-transform-react": "0.154.0",
    "prettier": "3.9.10",
    "sharp-cli": "^6.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-zip-pack": "^1.2.4",
    "vite-plus": "catalog:",
    "webextension-polyfill": "^0.12.0"
  }
}
